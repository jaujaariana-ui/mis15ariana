# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudinary (25 GB gratis, sin tarjeta de crédito)
# Crea una cuenta en https://cloudinary.com
# Obtén las credenciales en: Console → Settings → API Keys
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Este valor debe ser igual a CLOUDINARY_CLOUD_NAME (se usa en el navegador)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NODE_ENV=development
